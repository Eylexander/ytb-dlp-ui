APP_USER=admin
APP_PASSWORD=change-me
# Password of the bundled PostgreSQL (alphanumeric, it goes into a URL). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Keeps sessions valid across restarts. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Downloads running at the same time; the rest wait in the queue
MAX_CONCURRENT=2
# Set to true when served over HTTPS (e.g. behind another reverse proxy)
COOKIE_SECURE=false
